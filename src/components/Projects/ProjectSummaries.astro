---
import ContentBox from "@components/ContentBox.astro";
import ProjectPreview from "@components/Projects/ProjectPreview.astro";

// Project Images
import top5Spotify from "@assets/projects/top5spotify/top5spotify.png";
import threeJsMain from "@assets/projects/threeJsPortfolio/threeJsPortfolioMain.png";
import staticSiteAbout from "@assets/projects/staticSiteDesigns/staticSiteAbout.png";
import irsPageMain from "@assets/projects/irs/formsPageMain.png";
import workOhioMain from "@assets/projects/workOhio/workOhioMain.png";

import { top5SpotifyTech } from "src/pages/projects/top-5-spotify.astro";
import { threeJsTech } from "src/pages/projects/three-js-portfolio.astro";
import { staticSiteTech } from "src/pages/projects/static-site-designs.astro";

import { projectEmoji } from "src/pages/projects/projectEmoji";
import { irsFormsTech } from "src/pages/projects/irs-forms.astro";
import { workOhioTech } from "src/pages/projects/work-ohio.astro";
---

<ContentBox>
  <h2 class="border-b-2 border-gold mt-0" id="projects">Professional Works</h2>
  <header class="border-0 sm:mb-8 mb-0">
    Each individual page includes deeper detail, as well as live links and open-source code, when available (project-depending).
  </header>
  <div class="flex flex-col gap-8">
    <ProjectPreview
      title="IRS.gov -> Forms"
      summary="A federal contract through Deloitte, this project built and delivered an embedded forms system available to all US residents."
      link="/projects/irs-forms"
      emojis={projectEmoji.irs}
      tech={irsFormsTech}
      image={irsPageMain}
    />
    <ProjectPreview
      title="Work Ohio"
      summary="Contract work with the state of Ohio for Lieutenant Governor Jim Tressel's Ohio workforce initiative. A site built to help Ohio residents find work and training opportunities."
      link="/projects/work-ohio"
      emojis={projectEmoji.workOhio}
      tech={workOhioTech}
      image={workOhioMain}
    />
  </div>
  <h2 class="border-b-2 border-gold mt-0" id="projects">Personal Projects</h2>
  <header class="border-0 sm:mb-8 mb-0">
    These projects are no longer hosted live and in some cases are outdated examples of my current development skills, style, and strategies. They serve as a
    roadmap of my development from starting this career in 2017 however and I'm still proud of them for what (and when) they were.
  </header>
  <div class="flex flex-col gap-8">
    <ProjectPreview
      title="Static Site Designs (2025)"
      summary="Including this site, I've designed, built, and deployed 2 responsive websites with AstroJS and Tailwind CSS."
      link="/projects/static-site-designs"
      emojis={projectEmoji.staticSiteDesigns}
      tech={staticSiteTech}
      image={staticSiteAbout}
    />
    <ProjectPreview
      title="ThreeJS Portfolio (2023)"
      summary="A vaporwave & coffee-themed personal/portfolio website created with pure vanilla HTML5, CSS3, and JS except the background, which is crafted by ThreeJS, a Javascript library for rendering and animated 3D models in the browser."
      link="/projects/three-js-portfolio"
      emojis={projectEmoji.threeJsPortfolio}
      tech={threeJsTech}
      image={threeJsMain}
    /><ProjectPreview
      title="Top 5 Spotify (2021)"
      summary=`My "I'm going to teach myself React" project from 2021, built from the ground up to practice using ReactJS, responsive design, and asynchronous integration with a public API.`
      link="/projects/top-5-spotify"
      emojis={projectEmoji.top5Spotify}
      tech={top5SpotifyTech}
      image={top5Spotify}
    />
  </div>
</ContentBox>
